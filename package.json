{
  "name": "controller-meta-frontend",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:preview": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.elbadaernu.controllermeta",
    "productName": "ControllerMeta",
    "copyright": "Copyright © 2025 HK560",
    "icon": "src/assets/images/ControllerMeta.ico",
    "files": [
      "dist/**",
      "electron/**",
      "src/assets/images/ControllerMeta.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "vue": "^3.5.25",
    "vue-i18n": "^11.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.2",
    "code-inspector-plugin": "^1.4.2",
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vite-plugin-vue-inspector": "^5.3.2"
  }
}
